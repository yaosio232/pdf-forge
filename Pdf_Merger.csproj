<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pdf_Merger</RootNamespace>
    <AssemblyName>PDF Forge</AssemblyName>
    <Product>PDF Forge</Product>
    <AssemblyTitle>PDF Forge</AssemblyTitle>
    <Version>1.0.5.2</Version>
    <FileVersion>1.0.5.2</FileVersion>
    <InformationalVersion>1.0.5.2-pending-validation</InformationalVersion>
    <BuildDate>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))</BuildDate>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="iTextSharp" Version="5.5.13.6" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\PdfMergerIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Compile Remove="verification\**" />
    <None Remove="verification\**" />
    <EmbeddedResource Remove="verification\**" />
  </ItemGroup>
</Project>

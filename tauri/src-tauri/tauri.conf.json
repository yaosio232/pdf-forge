{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Forge 2",
  "version": "2.0.0-alpha.5",
  "identifier": "io.github.yaosio232.pdf-forge.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [{"label":"main","title":"PDF Forge 2","width":1280,"height":820,"minWidth":960,"minHeight":640,"maximized":true}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "icon": ["icons/icon.ico", "icons/128x128.png"],
    "shortDescription": "Offline PDF and document workflows",
    "resources": {"../public/markdown/":"resources/markdown/","../public/licenses/":"licenses/third-party/","../../LICENSE.md":"licenses/LICENSE.md","../../NOTICE.md":"licenses/NOTICE.md"},
    "windows": {"webviewInstallMode":{"type":"downloadBootstrapper","silent":true},"nsis":{"displayLanguageSelector":true,"languages":["English","TradChinese"]}}
  }
}
